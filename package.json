{
  "name": "pathforge-academy",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace=@workspace/api-server",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "private": true,
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@replit/connectors-sdk": "^0.4.1",
    "d3": "^7.9.0",
    "drizzle-zod": "^0.8.3",
    "firebase": "^12.18.0",
    "framer-motion": "^13.2.0",
    "prismjs": "^1.30.0",
    "react-firebase-hooks": "^5.1.1",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/prismjs": "^1.26.6",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*"
  ],
  "description": "Interactive computer science and algorithms learning platform.",
  "author": "Moussa",
  "keywords": [
    "react",
    "algorithms",
    "pathfinding",
    "visualizer",
    "education",
    "computer-science",
    "vite",
    "typescript",
    "dijkstra",
    "a-star",
    "graph-theory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoaedMoussa/Path-Forge.git"
  },
  "bugs": {
    "url": "https://github.com/MoaedMoussa/Path-Forge/issues"
  },
  "homepage": "https://github.com/MoaedMoussa/Path-Forge#readme"
}