{
  "entities": {
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A user's rank and XP in the PathForge academy.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9 _\\-]+$"
        },
        "xp": {
          "type": "number"
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "xp",
        "userId",
        "updatedAt"
      ]
    },
    "StudyRoom": {
      "title": "Study Room",
      "description": "A collaborative room for studying a specific course.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "courseId": {
          "type": "string",
          "maxLength": 50
        },
        "creatorId": {
          "type": "string",
          "maxLength": 128
        },
        "codeSnippet": {
          "type": "string",
          "maxLength": 10000
        },
        "language": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "roomCode": {
          "type": "string",
          "maxLength": 10
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxLength": 50
        }
      },
      "required": [
        "name",
        "courseId",
        "creatorId",
        "codeSnippet",
        "language",
        "createdAt",
        "updatedAt",
        "roomCode",
        "members"
      ]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message sent in a study room.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 50
        },
        "text": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "userName",
        "text",
        "createdAt"
      ]
    },
    "CourseProgress": {
      "title": "Course Progress",
      "description": "User's progress across courses",
      "type": "object",
      "properties": {
        "progress": {
          "type": "object"
        },
        "streak": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "progress",
        "streak",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "leaderboard/{userId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Global leaderboard of user XP"
    },
    "studyRooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/StudyRoom"
      },
      "description": "Active study rooms"
    },
    "studyRooms/{roomId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Messages inside a study room"
    },
    "courseProgress/{userId}": {
      "schema": {
        "$ref": "#/entities/CourseProgress"
      },
      "description": "User's course progress"
    }
  }
}