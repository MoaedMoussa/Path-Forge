rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function existing() { return resource.data; }
    
    match /courseProgress/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/notes/{lessonId} {
      allow read, write: if isOwner(userId);
    }

    
    match /lessonFeedback/{feedbackId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'upvotedBy'])
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
    }

    match /studyRooms/{roomId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
      
      match /messages/{messageId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }
    }
  }
}
